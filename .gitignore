/target
.DS_Store

# Never commit Nintendo files: games, BIOS/firmware dumps, saves, save states.
# See docs/PRD.md#legal-policy. scripts/check-no-nintendo-files.sh enforces this in CI.
*.gb
*.gbc
*.gba
*.nds
*.dsi
*.srl
*.3ds
*.cci
*.cxi
*.cia
*.3dsx
*.zcci
*.zcxi
*.z3dsx
# 3DS DSP firmware and keys, dumped from a console.
*.cdc
aes_keys.txt
seeddb.bin
*.zip
*.7z
*.sav
*.rtc
*.ss[0-9]
*.ls[0-9]
*.state
# Saves and save states the app set aside rather than replace, and saves
# kept from before a state was loaded over them.
*.sav.bak*
*.sav.before-load*
*.ss[0-9].bak*
*.ls[0-9].bak*
bios*.bin
firmware*.bin
/test-roms/
