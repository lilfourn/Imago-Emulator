<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions the release app needs
     (docs/decisions/0016-public-release.md):
     - allow-jit: the 3DS helper, this same executable, runs Azahar's core,
       whose CPU and shader JITs write code into MAP_JIT memory;
     - disable-library-validation: that helper loads Azahar's core and
       MoltenVK, downloaded at first use and not signed by our team (the
       core is re-signed ad hoc after its arm64 fix);
     - audio-input: the DS microphone. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
